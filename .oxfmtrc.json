{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "ignorePatterns": [
    "lib",
    "node_modules",
    "ios",
    "android",
    "dist",
    "doc_build",
    ".rspress",
    "docs/docs/public/google72c92fa3f3368c37.html",
    "**/*.md",
    "**/*.mdx"
  ],
  "sortImports": {
    "groups": [
      "type-import",
      ["value-builtin", "value-external"],
      "type-internal",
      "value-internal",
      ["type-parent", "type-sibling", "type-index"],
      ["value-parent", "value-sibling", "value-index"],
      "unknown"
    ]
  },
  "sortPackageJson": {
    "sortScripts": true
  },
  "singleQuote": true
}
