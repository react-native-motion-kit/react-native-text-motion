{
  "name": "@react-native-motion-kit/text-motion",
  "version": "0.1.0",
  "description": "High-performance split text animations for React Native, powered by Reanimated and extensible renderers.",
  "keywords": [
    "android",
    "ios",
    "react-native"
  ],
  "homepage": "https://github.com/react-native-motion-kit/react-native-text-motion#readme",
  "bugs": {
    "url": "https://github.com/react-native-motion-kit/react-native-text-motion/issues"
  },
  "license": "MIT",
  "author": "harang <dbd02169@naver.com> (https://github.com/saseungmin)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/react-native-motion-kit/react-native-text-motion.git"
  },
  "files": [
    "src",
    "lib",
    "android",
    "ios",
    "cpp",
    "*.podspec",
    "react-native.config.js",
    "README.md",
    "LICENSE",
    "!ios/build",
    "!android/build",
    "!android/gradle",
    "!android/gradlew",
    "!android/gradlew.bat",
    "!android/local.properties",
    "!**/__tests__",
    "!**/__fixtures__",
    "!**/__mocks__",
    "!**/.*"
  ],
  "main": "./lib/module/index.js",
  "types": "./lib/typescript/src/index.d.ts",
  "exports": {
    ".": {
      "react-native-motion-kit-text-motion-source": "./src/index.tsx",
      "types": "./lib/typescript/src/index.d.ts",
      "default": "./lib/module/index.js"
    },
    "./presets": {
      "react-native-motion-kit-text-motion-source": "./src/presets/index.ts",
      "types": "./lib/typescript/src/presets/index.d.ts",
      "default": "./lib/module/presets/index.js"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "build": "bob build && node scripts/check-declarations.mjs",
    "clean": "del-cli lib",
    "prepare": "pnpm run build",
    "test": "jest",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@babel/core": "^7.28.5",
    "@react-native/babel-preset": "0.85.3",
    "@react-native/jest-preset": "0.85.3",
    "@react-native/metro-config": "0.85.3",
    "@testing-library/react-native": "^14.0.1",
    "@types/jest": "^29.5.14",
    "@types/react": "^19.2.0",
    "babel-jest": "^29.7.0",
    "del-cli": "^7.0.0",
    "jest": "^29.7.0",
    "react": "catalog:",
    "react-native": "catalog:",
    "react-native-builder-bob": "^0.43.0",
    "react-native-reanimated": "catalog:",
    "react-native-worklets": "catalog:",
    "test-renderer": "^1.2.0",
    "typescript": "catalog:"
  },
  "peerDependencies": {
    "react": ">=18.0.0",
    "react-native": ">=0.76.0",
    "react-native-reanimated": ">=4.0.0",
    "react-native-worklets": ">=0.5.0"
  },
  "create-react-native-library": {
    "type": "library",
    "languages": "js",
    "tools": [
      "jest",
      "lefthook"
    ],
    "version": "0.63.0"
  },
  "react-native-builder-bob": {
    "source": "src",
    "output": "lib",
    "targets": [
      [
        "module",
        {
          "esm": true
        }
      ],
      [
        "typescript",
        {
          "project": "tsconfig.build.json"
        }
      ]
    ]
  }
}
